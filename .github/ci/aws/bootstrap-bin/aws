#!/usr/bin/env python3
"""Deploy the solution template subject to the sandbox's IAM and network controls.

The template can originate from a released bootstrap or this checkout. The AWS
role enforces the IAM boundary even if contributors change the bootstrap.
"""

import json
import os
import subprocess
import sys
import tempfile

args = sys.argv[1:]
cli = os.environ['CI_AWS_CLI']
if (args[:2] == ['cloudformation', 'describe-stacks'] and
        '--query' in args and
        args[args.index('--query') + 1] == 'Stacks[0].Tags[].[Key,Value]' and
        os.environ['CI_INHERIT_STACK_TAGS'] == 'false'):
    # General-purpose pool tests use EKS's built-in NodeClass. The bootstrap treats
    # inherited stack tags as a request to replace that NodeClass. Keep the infrastructure
    # ownership tag on AWS resources and outside the chart's optional runtime tag list.
    query_index = args.index('--query') + 1
    args[query_index] = "Stacks[0].Tags[?Key!='MigrationCI'].[Key,Value]"
if args[:2] != ['cloudformation', 'deploy'] or '--template-file' not in args:
    os.execv(cli, [cli, *args])

index = args.index('--template-file') + 1
if '--tags' in args:
    if 'MigrationCI=github' not in args:
        args.insert(args.index('--tags') + 1, 'MigrationCI=github')
else:
    args.extend(['--tags', 'MigrationCI=github'])
with open(args[index]) as source:
    template = json.load(source)
for logical_id, resource in template['Resources'].items():
    kind, props = resource['Type'], resource.get('Properties', {})
    if kind == 'AWS::IAM::Role':
        boundary = ('CI_CONTROL_PLANE_BOUNDARY_ARN' if logical_id.startswith('EKSInfraMigrationsEKSClusterRole')
                    else 'CI_ROLE_BOUNDARY_ARN')
        if boundary == 'CI_CONTROL_PLANE_BOUNDARY_ARN':
            # CloudFormation truncates autogenerated role names to 64 characters.
            props['RoleName'] = {'Fn::Sub': '${AWS::StackName}-eks-control'}
        props['PermissionsBoundary'] = os.environ[boundary]
    elif kind == 'AWS::SSM::Parameter' and 'KubectlReadyBarrier' in logical_id:
        props['Name'] = {'Fn::Sub': '/migrations-ci/${AWS::StackName}/kubectl-ready'}
    elif kind == 'AWS::EKS::Cluster':
        props['ResourcesVpcConfig'].update(
            EndpointPrivateAccess=True, PublicAccessCidrs=[os.environ['CI_WORKER_CIDR']]
        )
    elif kind == 'AWS::EC2::SecurityGroup':
        for rule in props.get('SecurityGroupIngress', []):
            # The imported test VPC has a known CIDR; permit its private HTTPS clients.
            if rule.get('CidrIp') == '0.0.0.0/0' and rule.get('FromPort') == 443:
                rule['CidrIp'] = os.environ['CI_VPC_CIDR']
with tempfile.NamedTemporaryFile(mode='w', suffix='.json') as output:
    json.dump(template, output, separators=(',', ':'))
    output.flush()
    args[index] = output.name
    sys.exit(subprocess.run([cli, *args]).returncode)
